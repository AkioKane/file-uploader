generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String  @unique
  password String
  role     Role    @default(USER)
  uploads  File[]
}

model File {
  id        Int  @id @default(autoincrement())
  author    User @relation(fields: [author_id], references: [id])
  author_id Int
  id_file   Int
}

enum Role {
  USER
  ADMIN
}
